{
  "openapi": "3.1.0",
  "info": {
    "title": "Jetski API",
    "version": "0.0.0",
    "description": "Implementation preview. This document covers implemented routes only; the v1 release acceptance matrix is not complete."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/capabilities": {
      "get": {
        "summary": "Inspect currently implemented capabilities",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Resource not found in principal scope"
          }
        }
      }
    },
    "/v1/sandboxes": {
      "get": {
        "summary": "List sandboxes owned by the authenticated principal",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Sandbox"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Resource not found in principal scope"
          }
        }
      },
      "post": {
        "summary": "Queue a sandbox creation with stable operation identity",
        "responses": {
          "202": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sandbox"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Resource not found in principal scope"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "operationId", "image"],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "operationId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "image": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/sandboxes/{sandboxId}": {
      "get": {
        "summary": "Inspect an owned sandbox",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sandbox"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Resource not found in principal scope"
          }
        }
      },
      "parameters": [
        {
          "name": "sandboxId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "delete": {
        "summary": "Delete a sandbox after durable release; acknowledged checkpoint and command history remains retained",
        "parameters": [
          {
            "name": "sandboxId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["operationId"],
                "properties": {
                  "operationId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Persisted operation; observe its ID for completion"
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Sandbox unavailable in principal scope"
          }
        }
      }
    },
    "/v1/sandboxes/{sandboxId}/operations/{operationId}": {
      "get": {
        "summary": "Observe a persisted lifecycle operation",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Resource not found in principal scope"
          }
        }
      },
      "parameters": [
        {
          "name": "sandboxId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "operationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/v1/sandboxes/{sandboxId}/commands": {
      "post": {
        "summary": "Admit a command with a caller-selected stable ID",
        "responses": {
          "202": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Resource not found in principal scope"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "argv"],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "argv": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "maxItems": 256
                  },
                  "cwd": {
                    "type": "string",
                    "default": "/workspace"
                  },
                  "timeout": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600,
                    "default": 120
                  }
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "sandboxId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/v1/sandboxes/{sandboxId}/commands/{commandId}": {
      "get": {
        "summary": "Observe host command status",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Resource not found in principal scope"
          }
        }
      },
      "parameters": [
        {
          "name": "sandboxId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "commandId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/v1/sandboxes/{sandboxId}/commands/{commandId}/output": {
      "get": {
        "summary": "Read a bounded stdout or stderr cursor segment",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Resource not found in principal scope"
          }
        },
        "parameters": [
          {
            "name": "channel",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["stdout", "stderr"],
              "default": "stdout"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "bytes",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144,
              "default": 65536
            }
          }
        ]
      },
      "parameters": [
        {
          "name": "sandboxId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "commandId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/v1/sandboxes/{sandboxId}/stop": {
      "post": {
        "summary": "Queue durable stop",
        "parameters": [
          {
            "name": "sandboxId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["operationId"],
                "properties": {
                  "operationId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Persisted operation; observe its ID for completion"
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Sandbox unavailable in principal scope"
          }
        }
      }
    },
    "/v1/sandboxes/{sandboxId}/checkpoint": {
      "post": {
        "summary": "Queue durable checkpoint",
        "parameters": [
          {
            "name": "sandboxId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["operationId"],
                "properties": {
                  "operationId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Persisted operation; observe its ID for completion"
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Sandbox unavailable in principal scope"
          }
        }
      }
    },
    "/v1/sandboxes/{sandboxId}/resume": {
      "post": {
        "summary": "Queue resume from a stopped checkpoint, releasing any held assignment before fresh restore",
        "parameters": [
          {
            "name": "sandboxId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["operationId"],
                "properties": {
                  "operationId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "checkpointId": {
                    "type": "string",
                    "description": "Optional retained filesystem checkpoint ID in this sandbox"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Sandbox queued with stable resume operation identity"
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Sandbox unavailable in principal scope"
          }
        },
        "description": "Resume a stopped sandbox from the latest checkpoint by default, or select a retained filesystem checkpoint explicitly. A durable lifecycle reference protects the selection until ready or queued cancellation. Reusing an operation ID with a different explicit checkpoint is rejected."
      }
    },
    "/v1/sandboxes/{sandbox}/files/read": {
      "get": {
        "summary": "Read a bounded binary file chunk",
        "description": "Live persistent-path observations; no symlink following. No snapshot guarantee. Directory scans are capped at 10000 entries.",
        "parameters": [
          {
            "name": "sandbox",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Previous observation token; rejects detectable changes"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          {
            "name": "bytes",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Base64 chunk with SHA-256, offsets, size, EOF and version"
          },
          "400": {
            "description": "Invalid path, stale version or unavailable assignment"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Sandbox outside principal scope"
          }
        }
      }
    },
    "/v1/sandboxes/{sandbox}/files/list": {
      "get": {
        "summary": "List a bounded directory page",
        "description": "Live persistent-path observations; no symlink following. No snapshot guarantee. Directory scans are capped at 10000 entries.",
        "parameters": [
          {
            "name": "sandbox",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Previous observation token; rejects detectable changes"
            }
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Entries, next cursor and version"
          },
          "400": {
            "description": "Invalid path, stale version or unavailable assignment"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Sandbox outside principal scope"
          }
        }
      }
    },
    "/v1/sandboxes/{sandbox}/files/uploads": {
      "post": {
        "summary": "Admit an immutable file upload operation",
        "parameters": [
          {
            "name": "sandbox",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "path": {
                    "type": "string"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 67108864
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 511
                  }
                },
                "required": ["id", "path", "bytes", "sha256"]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Upload admitted; receiving bytes does not publish the file"
          },
          "400": {
            "description": "Invalid input, state conflict or uncertain publication; inspect operation status"
          }
        }
      }
    },
    "/v1/sandboxes/{sandbox}/files/uploads/{upload}": {
      "get": {
        "summary": "Observe upload status without replaying publication",
        "parameters": [
          {
            "name": "sandbox",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "upload",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Upload status with durable phase and acknowledged offset"
          },
          "400": {
            "description": "Invalid input, state conflict or uncertain publication; inspect operation status"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Sandbox outside principal scope"
          }
        }
      },
      "put": {
        "summary": "Transfer a verified chunk of at most 256 KiB",
        "parameters": [
          {
            "name": "sandbox",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "upload",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "offset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "base64": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  }
                },
                "required": ["offset", "base64", "sha256"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload status with durable phase and acknowledged offset"
          },
          "400": {
            "description": "Invalid input, state conflict or uncertain publication; inspect operation status"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Sandbox outside principal scope"
          }
        }
      }
    },
    "/v1/sandboxes/{sandbox}/files/uploads/{upload}/finish": {
      "post": {
        "summary": "Persist publication intent and atomically install a verified file",
        "description": "Replay observes the same operation. Host-local publication is not a remote checkpoint acknowledgement. Uncertain publication prevents host release.",
        "parameters": [
          {
            "name": "sandbox",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "upload",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload status with durable phase and acknowledged offset"
          },
          "400": {
            "description": "Invalid input, state conflict or uncertain publication; inspect operation status"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Sandbox outside principal scope"
          }
        }
      }
    },
    "/v1/sandboxes/{sandbox}/checkpoints": {
      "get": {
        "summary": "List filesystem checkpoint history",
        "description": "Live keyset pagination by checkpoint ID; concurrent new checkpoints may require a fresh scan. Listing is not a storage integrity audit.",
        "parameters": [
          {
            "name": "sandbox",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filesystem checkpoint summaries, excluding command-output records"
          },
          "400": {
            "description": "Invalid request or ambiguous metadata"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource outside principal scope or unavailable"
          }
        }
      }
    },
    "/v1/sandboxes/{sandbox}/checkpoints/{checkpoint}": {
      "get": {
        "summary": "Inspect published checkpoint metadata and retention pins",
        "parameters": [
          {
            "name": "sandbox",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "checkpoint",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filesystem checkpoint summaries, excluding command-output records"
          },
          "400": {
            "description": "Invalid request or ambiguous metadata"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource outside principal scope or unavailable"
          }
        }
      }
    },
    "/v1/sandboxes/{sandbox}/checkpoints/{checkpoint}/pins": {
      "post": {
        "summary": "Atomically pin or unpin a filesystem checkpoint",
        "description": "Operation IDs have persisted outcomes. Replaying an old pin never undoes a subsequent unpin. Removing a pin does not retire or collect the checkpoint.",
        "parameters": [
          {
            "name": "sandbox",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "checkpoint",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["operationId", "pin", "retain"],
                "properties": {
                  "operationId": {
                    "type": "string"
                  },
                  "pin": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "retain": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Filesystem checkpoint summaries, excluding command-output records"
          },
          "400": {
            "description": "Invalid request or ambiguous metadata"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource outside principal scope or unavailable"
          }
        }
      }
    },
    "/v1/sandboxes/{sandboxId}/commands/{commandId}/cancel": {
      "parameters": [
        {
          "name": "sandboxId",
          "in": "path",
          "required": true,
