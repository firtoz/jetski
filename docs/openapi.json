{
  "openapi": "3.1.0",
  "info": {
    "title": "Jetski API",
    "version": "0.0.0",
    "description": "Implementation preview. This document covers implemented routes only; the v1 release acceptance matrix is not complete."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/capabilities": {
      "get": {
        "summary": "Inspect currently implemented capabilities",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Resource not found in principal scope"
          }
        }
      }
    },
    "/v1/sandboxes": {
      "get": {
        "summary": "List sandboxes owned by the authenticated principal",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Sandbox"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Resource not found in principal scope"
          }
        }
      },
      "post": {
        "summary": "Queue a sandbox creation with stable operation identity",
        "responses": {
          "202": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sandbox"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Resource not found in principal scope"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "operationId", "image"],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "operationId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "image": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/sandboxes/{sandboxId}": {
      "get": {
        "summary": "Inspect an owned sandbox",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sandbox"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Resource not found in principal scope"
          }
        }
      },
      "parameters": [
        {
          "name": "sandboxId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "delete": {
        "summary": "Delete a sandbox after durable release; acknowledged checkpoint and command history remains retained",
        "parameters": [
          {
            "name": "sandboxId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["operationId"],
                "properties": {
                  "operationId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Persisted operation; observe its ID for completion"
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Sandbox unavailable in principal scope"
          }
        }
      }
    },
    "/v1/sandboxes/{sandboxId}/operations/{operationId}": {
      "get": {
        "summary": "Observe a persisted lifecycle operation",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Resource not found in principal scope"
          }
        }
      },
      "parameters": [
        {
          "name": "sandboxId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "operationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/v1/sandboxes/{sandboxId}/commands": {
      "post": {
        "summary": "Admit a command with a caller-selected stable ID",
        "responses": {
          "202": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Resource not found in principal scope"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "argv"],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "argv": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "maxItems": 256
                  },
                  "cwd": {
                    "type": "string",
                    "default": "/workspace"
                  },
                  "timeout": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600,
                    "default": 120
                  }
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "sandboxId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/v1/sandboxes/{sandboxId}/commands/{commandId}": {
      "get": {
        "summary": "Observe host command status",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Resource not found in principal scope"
          }
        }
      },
      "parameters": [
        {
          "name": "sandboxId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "commandId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/v1/sandboxes/{sandboxId}/commands/{commandId}/output": {
      "get": {
        "summary": "Read a bounded stdout or stderr cursor segment",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Resource not found in principal scope"
          }
        },
        "parameters": [
          {
            "name": "channel",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["stdout", "stderr"],
              "default": "stdout"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "bytes",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 262144,
              "default": 65536
            }
          }
        ]
      },
      "parameters": [
        {
          "name": "sandboxId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "commandId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/v1/sandboxes/{sandboxId}/stop": {
      "post": {
        "summary": "Queue durable stop",
        "parameters": [
          {
            "name": "sandboxId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["operationId"],
                "properties": {
                  "operationId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Persisted operation; observe its ID for completion"
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Sandbox unavailable in principal scope"
          }
        }
      }
    },
    "/v1/sandboxes/{sandboxId}/checkpoint": {
      "post": {
        "summary": "Queue durable checkpoint",
        "parameters": [
          {
            "name": "sandboxId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["operationId"],
                "properties": {
                  "operationId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Persisted operation; observe its ID for completion"
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Sandbox unavailable in principal scope"
          }
        }
      }
    },
    "/v1/sandboxes/{sandboxId}/resume": {
      "post": {
        "summary": "Queue resume from a stopped checkpoint, releasing any held assignment before fresh restore",
        "parameters": [
          {
            "name": "sandboxId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["operationId"],
                "properties": {
                  "operationId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Sandbox queued with stable resume operation identity"
          },
          "400": {
            "description": "Invalid or rejected request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Sandbox unavailable in principal scope"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Sandbox": {
        "type": "object",
        "required": ["id", "owner", "image", "phase"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "owner": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "phase": {
            "type": "string",
            "enum": [
              "queued",
              "starting",
              "running",
              "stopping",
              "stopped",
              "quarantined",
              "deleted"
            ]
          }
        }
      }
    }
  }
}
