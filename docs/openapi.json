                            "maximum": 4096
                          }
                        },
                        "required": ["kind", "rows", "columns"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "signal"
                          },
                          "signal": {
