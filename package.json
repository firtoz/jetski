{
  "name": "jetski",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Portable, durable sandboxes on reusable compute",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1"
  },
  "exports": {
    "./core": "./dist/core/index.js",
    "./sdk": "./dist/sdk.js",
    "./storage/local": "./dist/storage/local.js",
    "./state/sqlite": "./dist/state/sqlite.js",
    "./providers/ssh": "./dist/providers/ssh.js",
    "./transport/ssh": "./dist/transport/ssh.js",
    "./server": "./dist/server/http.js",
    "./storage/s3": "./dist/storage/s3.js",
    "./server/storage": "./dist/server/storage.js"
  },
  "files": [
    "dist",
    "host",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test test/*.test.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.2",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  },
  "bin": {
    "jetski": "dist/cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0"
  }
}
