{
  "name": "jetski",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Portable, durable sandboxes on reusable compute",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1"
  },
  "exports": {
    "./core": "./dist/core/index.js",
    "./sdk": "./dist/sdk.js",
    "./storage/memory-codecs": "./dist/storage/memory-codecs.js",
    "./storage/local": "./dist/storage/local.js",
    "./state/sqlite": "./dist/state/sqlite.js",
    "./providers/ssh": "./dist/providers/ssh.js",
    "./transport/ssh": "./dist/transport/ssh.js",
    "./server": "./dist/server/http.js",
    "./storage/s3": "./dist/storage/s3.js",
    "./storage/integrity": "./dist/storage/integrity.js",
    "./storage/r2": "./dist/storage/r2.js",
    "./server/storage": "./dist/server/storage.js",
    "./testing/storage": "./dist/testing/storage.js",
    "./providers/boat": "./dist/providers/boat.js",
    "./providers/boat-pricing": "./dist/providers/boat-pricing.js",
    "./transport/boat-stream": "./dist/transport/boat-stream.js",
    "./transport/boat": "./dist/transport/boat.js",
    "./providers/boat-bootstrap": "./dist/providers/boat-bootstrap.js",
    "./server/hosts": "./dist/server/hosts.js",
    "./client/terminal": "./dist/client/terminal.js",
    "./server/ssh": "./dist/server/ssh.js",
    "./client/forward": "./dist/client/forward.js",
    "./server/preview": "./dist/server/preview.js",
    "./transport/duplex": "./dist/transport/duplex.js",
    "./providers/boat-bootstrap-embedded": "./dist/providers/boat-bootstrap-embedded.js",
    "./providers/boat-bootstrap-rust": "./dist/providers/boat-bootstrap-rust.js",
    "./transport/host-backend": "./dist/transport/host-backend.js",
    "./host-rust-assets": "./dist/host-rust-assets.js",
    "./host-assets": "./dist/host-assets.js",
    "./transport/http": "./dist/transport/http-forward.js",
    "./transport/websocket": "./dist/transport/websocket.js",
    "./server/preview-fetch": "./dist/server/preview-fetch.js",
    "./providers/runtime-selection": "./dist/providers/runtime-selection.js",
    "./providers/boat-runtime-selection": "./dist/providers/boat-runtime-selection.js"
  },
  "files": [
    "dist",
    "host",
    "host-rust/install.py",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-host-assets.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test test/*.test.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.2",
    "@types/node": "^24.10.0",
    "@types/ssh2": "1.15.6",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  },
  "bin": {
    "jetski": "dist/cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1160.0",
    "ssh2": "1.17.0"
  }
}
