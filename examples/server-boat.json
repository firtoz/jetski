{
  "dataDirectory": "./.jetski/server",
  "poolId": "example",
  "approvedImages": [
    "docker.io/library/alpine@sha256:2e0b81d60597f449baa56dc25d355367869d2dca4cd57e866f1e2b52af3eb55f"
  ],
  "port": 8788,
  "principals": [
    {
      "owner": "example",
      "tokenEnv": "JETSKI_API_TOKEN"
    }
  ],
  "hostProvider": {
    "kind": "boat",
    "tokenEnv": "BOAT_API_TOKEN",
    "machine": "small",
    "networkMode": "egress",
    "storageMode": "default"
  },
  "storage": {
    "kind": "local"
  },
  "hostLifecycle": {
    "lifetimeMs": 28800000,
    "drainMs": 300000,
    "idle": {
      "mode": "adaptive",
      "minMs": 120000,
      "maxMs": 3600000,
      "fallbackMs": 600000,
      "maxIdleSpendMicros": 18000
    }
  }
}
