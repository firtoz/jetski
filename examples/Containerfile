FROM docker.io/library/alpine@sha256:2e0b81d60597f449baa56dc25d355367869d2dca4cd57e866f1e2b52af3eb55f
RUN addgroup -g 1000 sandbox && adduser -D -u 1000 -G sandbox -h /home/sandbox sandbox \
    && mkdir -p /workspace && chown 1000:1000 /workspace
USER 1000:1000
WORKDIR /workspace
CMD ["sleep", "infinity"]
